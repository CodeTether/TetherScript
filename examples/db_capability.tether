// Database capability example.
//
// tetherscript ships no database driver, and scripts get no ambient database
// access: the host grants a `db` capability, and `db` is undefined without it.
// See examples/db_capability.rs for the Rust host that runs this file.
//
// Parameters are passed as a separate list, never concatenated into the SQL, so
// a value can never change the shape of the statement.

fn find_user(id) {
    let rows = db.query("SELECT id, name, active FROM users WHERE id = $1", [id])?
    if rows.len() == 0 {
        return Err("no user with id " + str(id))
    }
    return Ok(rows[0])
}

// A quoting attack stays inert: the value binds as text and matches no row.
fn injection_is_inert() {
    let hostile = "1 OR 1=1; DROP TABLE users"
    let rows = db.query("SELECT id FROM users WHERE name = $1", [hostile])?
    return Ok(rows.len())
}

fn report() {
    let user = find_user(1)?
    println("user: " + user.name)
    println("active: " + str(user.active))

    let all = db.query("SELECT id FROM users", [])?
    println("rows: " + str(all.len()))

    // nil binds as SQL NULL, so `IS NULL` matching works through a parameter.
    let missing = db.query("SELECT id FROM users WHERE note IS NOT DISTINCT FROM $1", [nil])?
    println("null-note rows: " + str(missing.len()))

    println("hostile matches: " + str(injection_is_inert()?))
    return Ok("ok")
}

export find_user
export injection_is_inert
export report
