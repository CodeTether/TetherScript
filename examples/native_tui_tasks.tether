// Native TUI powered by tetherscript's in-tree software renderer.
// cargo run --features native-window --bin tetherscript -- run examples/native_tui_tasks.tether

fn main() {
    let view = map()
    view["title"] = "Tether Tasks"
    view["status"] = "native workspace online"
    view["width"] = 100
    view["height"] = 40
    view["items"] = [
        "[x] Native rendering: Use the in-tree HTML/CSS rasterizer",
        "[x] Shared schema: Drive terminal and native views from tetherscript",
        "[x] Input handling: Accept native keyboard events and Unicode text",
        "[ ] Release build: Package the polished native experience",
        "[x] Dependency cleanup: Remove the external UI framework"
    ]

    tui_native(view).unwrap()
}